+               x->c[ 8] ^ x->c[10] ^ x->c[13];
+    y->c[14] = x->c[ 0] ^ x->c[ 3] ^ x->c[ 4] ^ x->c[ 5] ^
+               x->c[ 9] ^ x->c[11] ^ x->c[14];
+    y->c[15] = x->c[ 1] ^ x->c[ 2] ^ x->c[ 4] ^ x->c[ 5] ^
+               x->c[ 8] ^ x->c[10] ^ x->c[15];
+}
+
+/*
+ * Odd round function
+ * Apply the first substitution layer and then a diffusion step.
+ * It is safe for the input and output to overlap.
+ */
+static inline void FO(ARIA_u128 *o, const ARIA_u128 *d,
+                           const ARIA_u128 *rk)
+{
+    ARIA_u128 y;
+
+    sl1(&y, d, rk);
+    a(o, &y);
+}
+
+/*
+ * Even round function
+ * Apply the second substitution layer and then a diffusion step.
+ * It is safe for the input and output to overlap.
+ */
+static inline void FE(ARIA_u128 *o, const ARIA_u128 *d,
+                           const ARIA_u128 *rk)
+{
+    ARIA_u128 y;
+
+    sl2(y.c, d, rk);
+    a(o, &y);
+}
+
+/*
+ * Encrypt or decrypt a single block
+ * in and out can overlap
+ */
+static void do_encrypt(unsigned char *o, const unsigned char *pin,
+                       unsigned int rounds, const ARIA_u128 *keys)
+{
+    ARIA_u128 p;
+    unsigned int i;
+
+    memcpy(&p, pin, sizeof(p));
+    for (i = 0; i < rounds - 2; i += 2) {
+        FO(&p, &p, &keys[i]);
+        FE(&p, &p, &keys[i + 1]);
+    }
+    FO(&p, &p, &keys[rounds - 2]);
+    sl2(o, &p, &keys[rounds - 1]);
+    xor128(o, o, &keys[rounds]);
+}
+
+/*
+ * Encrypt a single block
+ * in and out can overlap
+ */
+static void aria_encrypt(const unsigned char *in, unsigned char *out,
+                       const ARIA_KEY *key)
+{
+    assert(in != NULL && out != NULL && key != NULL);
+    do_encrypt(out, in, key->rounds, key->rd_key);
+}
+
+
+/*
+ * Expand the cipher key into the encryption key schedule.
+ * We short circuit execution of the last two
+ * or four rotations based on the key size.
+ */
+static int aria_set_encrypt_key(const unsigned char *userKey, const int bits,
+                              ARIA_KEY *key)
+{
+    const ARIA_u128 *ck1, *ck2, *ck3;
+    ARIA_u128 kr, w0, w1, w2, w3;
+
+    if (!userKey || !key)
+        return -1;
+    memcpy(w0.c, userKey, sizeof(w0));
+    switch (bits) {
+    default:
+        return -2;
+    case 128:
+        key->rounds = 12;
+        ck1 = &c1;
+        ck2 = &c2;
+        ck3 = &c3;
+        memset(kr.c, 0, sizeof(kr));
+        break;
+
+    case 192:
+        key->rounds = 14;
+        ck1 = &c2;
+        ck2 = &c3;
+        ck3 = &c1;
+        memcpy(kr.c, userKey + ARIA_BLOCK_SIZE, sizeof(kr) / 2);
+        memset(kr.c + ARIA_BLOCK_SIZE / 2, 0, sizeof(kr) / 2);
+        break;
+
+    case 256:
+        key->rounds = 16;
+        ck1 = &c3;
+        ck2 = &c1;
+        ck3 = &c2;
+        memcpy(kr.c, userKey + ARIA_BLOCK_SIZE, sizeof(kr));
+        break;
+    }
+
+    FO(&w3, &w0, ck1);    xor128(w1.c, w3.c, &kr);
+    FE(&w3, &w1, ck2);    xor128(w2.c, w3.c, &w0);
+    FO(&kr, &w2, ck3);    xor128(w3.c, kr.c, &w1);
+
+    rot19r(&key->rd_key[ 0], &w0, &w1);
+    rot19r(&key->rd_key[ 1], &w1, &w2);
+    rot19r(&key->rd_key[ 2], &w2, &w3);
+    rot19r(&key->rd_key[ 3], &w3, &w0);
+
+    rot31r(&key->rd_key[ 4], &w0, &w1);
+    rot31r(&key->rd_key[ 5], &w1, &w2);
+    rot31r(&key->rd_key[ 6], &w2, &w3);
+    rot31r(&key->rd_key[ 7], &w3, &w0);
+
+    rot61l(&key->rd_key[ 8], &w0, &w1);
+    rot61l(&key->rd_key[ 9], &w1, &w2);
+    rot61l(&key->rd_key[10], &w2, &w3);
+    rot61l(&key->rd_key[11], &w3, &w0);
+
+    rot31l(&key->rd_key[12], &w0, &w1);
+    if (key->rounds > 12) {
+        rot31l(&key->rd_key[13], &w1, &w2);
+        rot31l(&key->rd_key[14], &w2, &w3);
+
+        if (key->rounds > 14) {
+            rot31l(&key->rd_key[15], &w3, &w0);
+            rot19l(&key->rd_key[16], &w0, &w1);
+        }
+    }
+    return 0;
+}
+
+struct aead_aria_gcm_ctx {
+    ARIA_KEY key;
+    uint8_t h[16];
+    uint64_t min_next_nonce;
+};
+
+static_assert(sizeof(aead_aria_gcm_ctx) <= sizeof(evp_aead_ctx_st_state),
+              "ARIA-GCM context exceeds EVP_AEAD_CTX state");
+
+static void shift_right_one(uint8_t block[16]) {
+    uint8_t carry = 0;
+    for (size_t i = 0; i < 16; i++) {
+        const uint8_t next = block[i] & 1;
+        block[i] = static_cast<uint8_t>((block[i] >> 1) | (carry << 7));
+        carry = next;
+    }
+    block[0] ^= static_cast<uint8_t>(0xe1 & (0u - carry));
+}
+
+static void ghash_multiply(uint8_t x[16], const uint8_t h[16]) {
+    uint8_t z[16] = {0};
+    uint8_t v[16];
+    OPENSSL_memcpy(v, h, sizeof(v));
+    for (size_t bit = 0; bit < 128; bit++) {
+        const uint8_t mask =
+            static_cast<uint8_t>(0u - ((x[bit / 8] >> (7 - bit % 8)) & 1u));
+        for (size_t i = 0; i < 16; i++) {
+            z[i] ^= v[i] & mask;
+        }
+        shift_right_one(v);
+    }
+    OPENSSL_memcpy(x, z, sizeof(z));
+}
+
+struct ghash_state {
+    uint8_t y[16];
+    uint8_t partial[16];
+    size_t used;
+};
+
+static void ghash_block(ghash_state *state, const uint8_t h[16],
+                        const uint8_t block[16]) {
+    for (size_t i = 0; i < 16; i++) {
+        state->y[i] ^= block[i];
+    }
+    ghash_multiply(state->y, h);
+}
+
+static void ghash_update(ghash_state *state, const uint8_t h[16],
+                         const uint8_t *in, size_t len) {
+    while (len > 0) {
+        const size_t take = len < 16 - state->used ? len : 16 - state->used;
+        OPENSSL_memcpy(state->partial + state->used, in, take);
+        state->used += take;
+        in += take;
+        len -= take;
+        if (state->used == 16) {
+            ghash_block(state, h, state->partial);
+            OPENSSL_memset(state->partial, 0, sizeof(state->partial));
+            state->used = 0;
+        }
+    }
+}
+
+static void ghash_pad(ghash_state *state, const uint8_t h[16]) {
+    if (state->used != 0) {
+        ghash_block(state, h, state->partial);
+        OPENSSL_memset(state->partial, 0, sizeof(state->partial));
+        state->used = 0;
+    }
+}
+
+static void increment_counter(uint8_t counter[16]) {
+    uint32_t value = CRYPTO_load_u32_be(counter + 12);
+    CRYPTO_store_u32_be(counter + 12, value + 1);
+}
+
+struct ctr_state {
+    uint8_t counter[16];
+    uint8_t stream[16];
+    size_t used;
+};
+
+static void aria_ctr(const ARIA_KEY *key, ctr_state *state, uint8_t *out,
+                     const uint8_t *in, size_t len) {
+    while (len > 0) {
+        if (state->used == 16) {
+            increment_counter(state->counter);
+            aria_encrypt(state->counter, state->stream, key);
+            state->used = 0;
+        }
+        const size_t take = len < 16 - state->used ? len : 16 - state->used;
+        for (size_t i = 0; i < take; i++) {
+            out[i] = in[i] ^ state->stream[state->used + i];
+        }
+        state->used += take;
+        out += take;
+        in += take;
+        len -= take;
+    }
+}
+
+static bool aria_gcm_tag(const aead_aria_gcm_ctx *aria, uint8_t tag[16],
+                         const uint8_t nonce[12], const uint8_t *ad,
+                         size_t ad_len, const uint8_t *ciphertext,
+                         size_t ciphertext_len, const uint8_t *extra,
+                         size_t extra_len) {
+    if (ad_len > (UINT64_C(1) << 61) ||
+        ciphertext_len > ((UINT64_C(1) << 36) - 32) ||
+        extra_len > ((UINT64_C(1) << 36) - 32) - ciphertext_len) {
+        return false;
+    }
+    ghash_state state = {};
+    ghash_update(&state, aria->h, ad, ad_len);
+    ghash_pad(&state, aria->h);
+    ghash_update(&state, aria->h, ciphertext, ciphertext_len);
+    ghash_update(&state, aria->h, extra, extra_len);
+    ghash_pad(&state, aria->h);
+    uint8_t lengths[16];
+    CRYPTO_store_u64_be(lengths, static_cast<uint64_t>(ad_len) << 3);
+    CRYPTO_store_u64_be(lengths + 8,
+                        static_cast<uint64_t>(ciphertext_len + extra_len) << 3);
+    ghash_block(&state, aria->h, lengths);
+
+    uint8_t j0[16] = {0};
+    OPENSSL_memcpy(j0, nonce, 12);
+    j0[15] = 1;
+    aria_encrypt(j0, tag, &aria->key);
+    for (size_t i = 0; i < 16; i++) {
+        tag[i] ^= state.y[i];
+    }
+    return true;
+}
+
+static int aead_aria_gcm_init(EVP_AEAD_CTX *ctx, const uint8_t *key,
+                              size_t key_len, size_t requested_tag_len) {
+    if (key_len != ctx->aead->key_len) {
+        OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BAD_KEY_LENGTH);
+        return 0;
+    }
+    if (requested_tag_len != EVP_AEAD_DEFAULT_TAG_LENGTH &&
+        requested_tag_len != 16) {
+        OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_UNSUPPORTED_TAG_SIZE);
+        return 0;
+    }
+    auto *aria = reinterpret_cast<aead_aria_gcm_ctx *>(&ctx->state);
+    OPENSSL_memset(aria, 0, sizeof(*aria));
+    if (aria_set_encrypt_key(key, static_cast<int>(key_len * 8), &aria->key) != 0) {
+        OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BAD_KEY_LENGTH);
+        return 0;
+    }
+    uint8_t zero[16] = {0};
+    aria_encrypt(zero, aria->h, &aria->key);
+    ctx->tag_len = 16;
+    return 1;
+}
+
+static void aead_aria_gcm_cleanup(EVP_AEAD_CTX *ctx) {
+    OPENSSL_memset(&ctx->state, 0, sizeof(ctx->state));
+}
+
+static int aead_aria_gcm_seal_scatter(
+    const EVP_AEAD_CTX *ctx, uint8_t *out, uint8_t *out_tag,
+    size_t *out_tag_len, size_t max_out_tag_len, const uint8_t *nonce,
+    size_t nonce_len, const uint8_t *in, size_t in_len, const uint8_t *extra_in,
+    size_t extra_in_len, const uint8_t *ad, size_t ad_len) {
+    if (nonce_len != 12) {
+        OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_UNSUPPORTED_NONCE_SIZE);
+        return 0;
+    }
+    if (extra_in_len > max_out_tag_len ||
+        ctx->tag_len > max_out_tag_len - extra_in_len) {
+        OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BUFFER_TOO_SMALL);
+        return 0;
+    }
+    if (extra_in_len > SIZE_MAX - in_len ||
+        in_len + extra_in_len > ((UINT64_C(1) << 36) - 32)) {
+        OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_TOO_LARGE);
+        return 0;
+    }
+
+    auto *aria = reinterpret_cast<aead_aria_gcm_ctx *>(
+        const_cast<evp_aead_ctx_st_state *>(&ctx->state));
+    const uint64_t counter_value = CRYPTO_load_u64_be(nonce + 4);
+    if (counter_value == UINT64_MAX || counter_value < aria->min_next_nonce) {
+        OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_INVALID_NONCE);
+        return 0;
+    }
+    aria->min_next_nonce = counter_value + 1;
+
+    ctr_state ctr = {};
+    OPENSSL_memcpy(ctr.counter, nonce, 12);
+    ctr.counter[15] = 1;
+    ctr.used = 16;
+    aria_ctr(&aria->key, &ctr, out, in, in_len);
+    aria_ctr(&aria->key, &ctr, out_tag, extra_in, extra_in_len);
+    uint8_t tag[16];
+    if (!aria_gcm_tag(aria, tag, nonce, ad, ad_len, out, in_len, out_tag,
+                      extra_in_len)) {
+        OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_TOO_LARGE);
+        return 0;
+    }
+    OPENSSL_memcpy(out_tag + extra_in_len, tag, sizeof(tag));
+    *out_tag_len = extra_in_len + sizeof(tag);
+    return 1;
+}
+
+static int aead_aria_gcm_open_gather(
+    const EVP_AEAD_CTX *ctx, uint8_t *out, const uint8_t *nonce,
+    size_t nonce_len, const uint8_t *in, size_t in_len, const uint8_t *in_tag,
+    size_t in_tag_len, const uint8_t *ad, size_t ad_len) {
+    if (nonce_len != 12 || in_tag_len != 16) {
+        OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BAD_DECRYPT);
+        return 0;
+    }
+    const auto *aria =
+        reinterpret_cast<const aead_aria_gcm_ctx *>(&ctx->state);
+    uint8_t expected[16];
+    if (!aria_gcm_tag(aria, expected, nonce, ad, ad_len, in, in_len, nullptr,
+                      0) ||
+        CRYPTO_memcmp(expected, in_tag, sizeof(expected)) != 0) {
+        OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BAD_DECRYPT);
+        return 0;
+    }
+    ctr_state ctr = {};
+    OPENSSL_memcpy(ctr.counter, nonce, 12);
+    ctr.counter[15] = 1;
+    ctr.used = 16;
+    aria_ctr(&aria->key, &ctr, out, in, in_len);
+    return 1;
+}
+
+static const EVP_AEAD aead_aria_128_gcm_tls12 = {
+    16, 12, 16, 16, 1,
+    aead_aria_gcm_init,
+    nullptr,
+    aead_aria_gcm_cleanup,
+    nullptr,
+    aead_aria_gcm_seal_scatter,
+    aead_aria_gcm_open_gather,
+    nullptr,
+    nullptr,
+};
+
+static const EVP_AEAD aead_aria_256_gcm_tls12 = {
+    32, 12, 16, 16, 1,
+    aead_aria_gcm_init,
+    nullptr,
+    aead_aria_gcm_cleanup,
+    nullptr,
+    aead_aria_gcm_seal_scatter,
+    aead_aria_gcm_open_gather,
+    nullptr,
+    nullptr,
+};
+
+const EVP_AEAD *EVP_aead_aria_128_gcm_tls12(void) {
+    return &aead_aria_128_gcm_tls12;
+}
+
+const EVP_AEAD *EVP_aead_aria_256_gcm_tls12(void) {
+    return &aead_aria_256_gcm_tls12;
+}
