+static uint8_t sbox_lookup(const unsigned char table[256], uint8_t index) {
+    uint8_t value = 0;
+    for (unsigned i = 0; i < 256; i++) {
+        value |= table[i] & constant_time_eq_8(index, static_cast<uint8_t>(i));
+    }
+    return value;
+}
