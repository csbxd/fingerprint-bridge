+    const bool compressed = compressed_ && peer.size() == 37 &&
+                            (peer[0] == 2 || peer[0] == 3);
+    if ((!uncompressed && !compressed) ||
+        !callbacks_->derive(key_, candidate.data(), peer.data(), peer.size())) {
+      OPENSSL_cleanse(candidate.data(), candidate.size());
+      *alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+    *secret = std::move(candidate);
+    return true;
+  }
+  // This legacy TLS 1.2 capability is never used for TLS 1.3/HRR key shares.
+  bool SerializePrivateKey(CBB *) override { return false; }
+  bool DeserializePrivateKey(CBS *) override { return false; }
+
+ private:
+  const SSL_BRIDGE_CHAR2_CALLBACKS *const callbacks_;
+  const bool compressed_;
+  void *key_ = nullptr;
+};
