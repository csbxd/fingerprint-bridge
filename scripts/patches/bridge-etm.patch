+bool SSLAEADContext::EtmMAC(uint8_t *out, uint8_t type, uint16_t version,
+                            uint64_t seqnum, Span<const uint8_t> fragment) {
+  // RFC 7366 authenticates the length of IV+ciphertext, excluding the MAC.
+  if (fragment.size() > 0xffff) {
+    return false;
+  }
+  uint8_t ad[13];
+  CRYPTO_store_u64_be(ad, seqnum);
+  ad[8] = type;
+  ad[9] = version >> 8;
+  ad[10] = version;
+  ad[11] = fragment.size() >> 8;
+  ad[12] = fragment.size();
+  unsigned len;
+  return HMAC_Init_ex(etm_hmac_.get(), nullptr, 0, nullptr, nullptr) &&
+         HMAC_Update(etm_hmac_.get(), ad, sizeof(ad)) &&
+         HMAC_Update(etm_hmac_.get(), fragment.data(), fragment.size()) &&
+         HMAC_Final(etm_hmac_.get(), out, &len) && len == etm_mac_len_;
+}
