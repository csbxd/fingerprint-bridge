+// RFC 7366 encrypt-then-MAC. This bridge API implements the upstream TLS
+// client only; a B-side server never advertises an unimplemented capability.
+static bool ext_etm_add_clienthello(const SSL_HANDSHAKE *hs, CBB *out,
+                                    CBB *out_compressible,
+                                    ssl_client_hello_type_t type) {
+  if (!hs->config->bridge_encrypt_then_mac || hs->min_version > TLS1_2_VERSION ||
+      SSL_is_dtls(hs->ssl) || type == ssl_client_hello_inner) {
+    return true;
+  }
+  return CBB_add_u16(out, 22) && CBB_add_u16(out, 0);
+}
+
+static bool ext_etm_parse_serverhello(SSL_HANDSHAKE *hs, uint8_t *out_alert,
+                                     CBS *contents) {
+  SSL *ssl = hs->ssl;
+  const bool negotiated = contents != nullptr;
+  if ((negotiated && (CBS_len(contents) != 0 ||
+                     !hs->config->bridge_encrypt_then_mac ||
+                     ssl->s3->version != TLS1_2_VERSION ||
+                     !SSL_CIPHER_is_block_cipher(hs->new_cipher))) ||
+      (ssl->s3->encrypt_then_mac && !negotiated)) {
+    *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+    OPENSSL_PUT_ERROR(SSL, SSL_R_UNEXPECTED_EXTENSION);
+    return false;
+  }
+  ssl->s3->encrypt_then_mac = negotiated;
+  return true;
+}
