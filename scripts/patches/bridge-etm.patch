+bool SSLAEADContext::OpenEtm(Span<uint8_t> *out, uint8_t type,
+                             uint16_t version, uint64_t seqnum,
+                             Span<uint8_t> in) {
+  const size_t block = variable_nonce_len_;
+  if (in.size() < etm_mac_len_ + 2 * block) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_PACKET_LENGTH);
+    return false;
+  }
+  auto fragment = in.first(in.size() - etm_mac_len_);
+  uint8_t mac[EVP_MAX_MD_SIZE];
+  // Authenticate BEFORE checking ciphertext alignment, decrypting, or examining
+  // padding. No unauthenticated plaintext or padding reaches a parser.
+  if (!EtmMAC(mac, type, version, seqnum, fragment) ||
+      CRYPTO_memcmp(mac, in.data() + fragment.size(), etm_mac_len_) != 0) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_DECRYPTION_FAILED_OR_BAD_RECORD_MAC);
+    return false;
+  }
+  auto encrypted = fragment.subspan(block);
+  if (encrypted.size() % block != 0) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_PACKET_LENGTH);
+    return false;
+  }
+  int written = 0, final = 0;
+  if (!EVP_CipherInit_ex(etm_cipher_.get(), nullptr, nullptr, nullptr,
+                         fragment.data(), -1) ||
+      !EVP_CipherUpdate(etm_cipher_.get(), encrypted.data(), &written,
+                        encrypted.data(), encrypted.size()) ||
+      !EVP_CipherFinal_ex(etm_cipher_.get(), encrypted.data() + written, &final) ||
+      static_cast<size_t>(written + final) != encrypted.size()) {
+    return false;
+  }
+  const size_t padding = static_cast<size_t>(encrypted.back()) + 1;
+  if (padding > encrypted.size()) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_DECRYPTION_FAILED_OR_BAD_RECORD_MAC);
+    return false;
+  }
+  uint8_t mismatch = 0;
+  for (size_t i = 0; i < padding; i++) {
+    mismatch |= encrypted[encrypted.size() - 1 - i] ^ (padding - 1);
+  }
+  if (mismatch != 0) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_DECRYPTION_FAILED_OR_BAD_RECORD_MAC);
+    return false;
+  }
+  *out = encrypted.first(encrypted.size() - padding);
+  return true;
+}
+
+bool SSLAEADContext::SealEtm(uint8_t *prefix, uint8_t *out, uint8_t *suffix,
+                             uint8_t type, uint16_t version, uint64_t seqnum,
+                             Span<const uint8_t> in, Span<const uint8_t> extra) {
+  size_t suffix_len;
+  if (!SuffixLen(&suffix_len, in.size(), extra.size())) {
+    return false;
+  }
+  const size_t block = variable_nonce_len_;
+  const size_t encrypted_len = in.size() + suffix_len - etm_mac_len_;
+  Array<uint8_t> fragment;
+  if (!fragment.InitForOverwrite(block + encrypted_len) ||
+      !RAND_bytes(fragment.data(), block)) {
+    return false;
+  }
+  auto body = Span(fragment).subspan(block);
+  OPENSSL_memcpy(body.data(), in.data(), in.size());
+  OPENSSL_memcpy(body.data() + in.size(), extra.data(), extra.size());
+  const size_t padding = encrypted_len - in.size() - extra.size();
+  OPENSSL_memset(body.data() + in.size() + extra.size(), padding - 1, padding);
+  int written = 0, final = 0;
+  const bool encrypted =
+      EVP_CipherInit_ex(etm_cipher_.get(), nullptr, nullptr, nullptr,
+                        fragment.data(), -1) &&
+      EVP_CipherUpdate(etm_cipher_.get(), body.data(), &written, body.data(),
+                       body.size()) &&
+      EVP_CipherFinal_ex(etm_cipher_.get(), body.data() + written, &final) &&
+      static_cast<size_t>(written + final) == encrypted_len;
+  if (!encrypted) {
+    OPENSSL_cleanse(body.data(), body.size());
+    return false;
+  }
+  uint8_t mac[EVP_MAX_MD_SIZE];
+  if (!EtmMAC(mac, type, version, seqnum, fragment)) {
+    return false;
+  }
+  OPENSSL_memcpy(prefix, fragment.data(), block);
+  OPENSSL_memcpy(out, body.data(), in.size());
+  OPENSSL_memcpy(suffix, body.data() + in.size(), encrypted_len - in.size());
+  OPENSSL_memcpy(suffix + encrypted_len - in.size(), mac, etm_mac_len_);
+  return true;
+}
