+int SSL_set_bridge_profile(SSL *ssl, const uint16_t *ciphers,
+                           size_t count, int padding) {
+  if (ssl->config == nullptr || ssl->s3->initial_handshake_complete ||
+      count == 0 || count > 512 || ciphers == nullptr ||
+      (padding != 0 && padding != 1)) {
+    return 0;
+  }
+  for (size_t i = 0; i < count; i++) {
+    const uint16_t id = ciphers[i];
+    if (id == SSL_CIPHER_EMPTY_RENEGOTIATION_INFO_SCSV ||
+        ((id & 0x0f0f) == 0x0a0a && (id >> 8) == (id & 0xff))) {
+      continue;
+    }
+    bool enabled = false;
+    for (const SSL_CIPHER *cipher : SSL_get_ciphers(ssl)) {
+      enabled |= SSL_CIPHER_get_protocol_id(cipher) == id;
+    }
+    if (ssl->ctx->tls13_cipher_list) {
+      for (const SSL_CIPHER *cipher : ssl->ctx->tls13_cipher_list->ciphers.get()) {
+        enabled |= SSL_CIPHER_get_protocol_id(cipher) == id;
+      }
+    }
+    if (!enabled) {
+      return 0;
+    }
+  }
+  if (!ssl->config->bridge_cipher_order.CopyFrom(Span(ciphers, count))) {
+    return 0;
+  }
+  ssl->config->bridge_padding = padding;
+  return 1;
+}
