+// RFC 6961 multiple-certificate OCSP stapling. The bridge requests only
+// ocsp_multi with empty responder and request-extension lists. This is the
+// exact capability it validates after normal certificate-chain verification.
+static bool ext_ocsp_v2_add_clienthello(const SSL_HANDSHAKE *hs, CBB *out,
+                                        CBB *out_compressible,
+                                        ssl_client_hello_type_t type) {
+  if (!hs->config->bridge_status_request_v2_enabled) {
+    return true;
+  }
+  CBB contents, requests, request;
+  return CBB_add_u16(out_compressible, TLSEXT_TYPE_status_request_v2) &&
+         CBB_add_u16_length_prefixed(out_compressible, &contents) &&
+         CBB_add_u16_length_prefixed(&contents, &requests) &&
+         CBB_add_u8(&requests, TLSEXT_STATUSTYPE_ocsp_multi) &&
+         CBB_add_u16_length_prefixed(&requests, &request) &&
+         CBB_add_u16(&request, 0 /* empty responder ID list */) &&
+         CBB_add_u16(&request, 0 /* empty request extensions */) &&
+         CBB_flush(out_compressible);
+}
+
+static bool ext_ocsp_v2_parse_serverhello(SSL_HANDSHAKE *hs,
+                                          uint8_t *out_alert,
+                                          CBS *contents) {
+  if (contents == nullptr) {
+    return true;
+  }
+  if (ssl_protocol_version(hs->ssl) >= TLS1_3_VERSION ||
+      CBS_len(contents) != 0 ||
+      !ssl_cipher_uses_certificate_auth(hs->new_cipher) ||
+      hs->certificate_status_expected) {
+    return false;
+  }
+  hs->certificate_status_expected = true;
+  hs->certificate_status_v2_expected = true;
+  return true;
+}
