+int SSL_set_bridge_status_request_v2(SSL *ssl, int enabled) {
+  if (ssl->config == nullptr || ssl->s3->initial_handshake_complete ||
+      SSL_is_dtls(ssl) || (enabled != 0 && enabled != 1)) {
+    return 0;
+  }
+  ssl->config->bridge_status_request_v2_enabled = enabled != 0;
+  return 1;
+}
