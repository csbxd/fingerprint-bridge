diff --git a/crypto/fipsmodule/cipher/e_aesccm.cc.inc b/crypto/fipsmodule/cipher/e_aesccm.cc.inc
index af5077e..3fe790d 100644
--- a/crypto/fipsmodule/cipher/e_aesccm.cc.inc
+++ b/crypto/fipsmodule/cipher/e_aesccm.cc.inc
@@ -408,3 +408,117 @@ DEFINE_METHOD_FUNCTION(EVP_AEAD, EVP_aead_aes_128_ccm_matter) {
   out->seal_scatter = aead_aes_ccm_seal_scatter;
   out->open_gather = aead_aes_ccm_open_gather;
 }
+
+
+// RFC 6655 / RFC 8446 use 12-byte nonces (L=3).  TLS 1.3 passes the
+// encrypted content type separately from the body to seal_scatter.  Join the
+// two inputs before authenticating: padding each fragment independently would
+// produce a different CBC-MAC, and restarting CTR would reuse its first block.
+static int aead_aes_ccm_tls_seal_scatter(
+    const EVP_AEAD_CTX *ctx, uint8_t *out, uint8_t *out_tag,
+    size_t *out_tag_len, size_t max_out_tag_len, const uint8_t *nonce,
+    size_t nonce_len, const uint8_t *in, size_t in_len, const uint8_t *extra_in,
+    size_t extra_in_len, const uint8_t *ad, size_t ad_len) {
+  if (extra_in_len == 0) {
+    return aead_aes_ccm_seal_scatter(ctx, out, out_tag, out_tag_len,
+                                   max_out_tag_len, nonce, nonce_len, in, in_len,
+                                   nullptr, 0, ad, ad_len);
+  }
+  const auto *ccm_ctx =
+      reinterpret_cast<const aead_aes_ccm_ctx *>(&ctx->state);
+  if (extra_in_len > SIZE_MAX - in_len ||
+      in_len + extra_in_len > CRYPTO_ccm128_max_input(&ccm_ctx->ccm)) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_TOO_LARGE);
+    return 0;
+  }
+  if (extra_in_len > max_out_tag_len ||
+      ctx->tag_len > max_out_tag_len - extra_in_len) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_BUFFER_TOO_SMALL);
+    return 0;
+  }
+  if (nonce_len != EVP_AEAD_nonce_length(ctx->aead)) {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_INVALID_NONCE_SIZE);
+    return 0;
+  }
+  const size_t len = in_len + extra_in_len;
+  uint8_t *joined = static_cast<uint8_t *>(OPENSSL_malloc(len));
+  if (joined == nullptr) {
+    return 0;
+  }
+  OPENSSL_memcpy(joined, in, in_len);
+  OPENSSL_memcpy(joined + in_len, extra_in, extra_in_len);
+  const int ok = CRYPTO_ccm128_encrypt(
+      &ccm_ctx->ccm, &ccm_ctx->ks.ks, joined, out_tag + extra_in_len,
+      ctx->tag_len, nonce, nonce_len, joined, len, ad, ad_len);
+  if (ok) {
+    OPENSSL_memcpy(out, joined, in_len);
+    OPENSSL_memcpy(out_tag, joined + in_len, extra_in_len);
+    *out_tag_len = extra_in_len + ctx->tag_len;
+  } else {
+    OPENSSL_PUT_ERROR(CIPHER, CIPHER_R_TOO_LARGE);
+  }
+  OPENSSL_clear_free(joined, len);
+  return ok;
+}
+
+static int aead_aes_ccm_tls_init(EVP_AEAD_CTX *ctx, const uint8_t *key,
+                               size_t key_len, size_t tag_len) {
+  return aead_aes_ccm_init(ctx, key, key_len, tag_len, 16, 3);
+}
+
+static int aead_aes_ccm_8_tls_init(EVP_AEAD_CTX *ctx, const uint8_t *key,
+                                 size_t key_len, size_t tag_len) {
+  return aead_aes_ccm_init(ctx, key, key_len, tag_len, 8, 3);
+}
+
+DEFINE_METHOD_FUNCTION(EVP_AEAD, EVP_aead_aes_128_ccm) {
+  memset(out, 0, sizeof(EVP_AEAD));
+  out->key_len = 16;
+  out->nonce_len = 12;
+  out->overhead = 16;
+  out->max_tag_len = 16;
+  out->init = aead_aes_ccm_tls_init;
+  out->cleanup = aead_aes_ccm_cleanup;
+  out->seal_scatter = aead_aes_ccm_tls_seal_scatter;
+  out->open_gather = aead_aes_ccm_open_gather;
+  out->seal_scatter_supports_extra_in = 1;
+}
+
+DEFINE_METHOD_FUNCTION(EVP_AEAD, EVP_aead_aes_128_ccm_8) {
+  memset(out, 0, sizeof(EVP_AEAD));
+  out->key_len = 16;
+  out->nonce_len = 12;
+  out->overhead = 8;
+  out->max_tag_len = 8;
+  out->init = aead_aes_ccm_8_tls_init;
+  out->cleanup = aead_aes_ccm_cleanup;
+  out->seal_scatter = aead_aes_ccm_tls_seal_scatter;
+  out->open_gather = aead_aes_ccm_open_gather;
+  out->seal_scatter_supports_extra_in = 1;
+}
+
+DEFINE_METHOD_FUNCTION(EVP_AEAD, EVP_aead_aes_256_ccm) {
+  memset(out, 0, sizeof(EVP_AEAD));
+  out->key_len = 32;
+  out->nonce_len = 12;
+  out->overhead = 16;
+  out->max_tag_len = 16;
+  out->init = aead_aes_ccm_tls_init;
+  out->cleanup = aead_aes_ccm_cleanup;
+  out->seal_scatter = aead_aes_ccm_tls_seal_scatter;
+  out->open_gather = aead_aes_ccm_open_gather;
+  out->seal_scatter_supports_extra_in = 1;
+}
+
+DEFINE_METHOD_FUNCTION(EVP_AEAD, EVP_aead_aes_256_ccm_8) {
+  memset(out, 0, sizeof(EVP_AEAD));
+  out->key_len = 32;
+  out->nonce_len = 12;
+  out->overhead = 8;
+  out->max_tag_len = 8;
+  out->init = aead_aes_ccm_8_tls_init;
+  out->cleanup = aead_aes_ccm_cleanup;
+  out->seal_scatter = aead_aes_ccm_tls_seal_scatter;
+  out->open_gather = aead_aes_ccm_open_gather;
+  out->seal_scatter_supports_extra_in = 1;
+}
