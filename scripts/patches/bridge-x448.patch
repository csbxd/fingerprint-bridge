+int SSL_set_bridge_x448_callback(SSL_BRIDGE_X448_CALLBACK callback) {
+  if (callback == nullptr) {
+    return 0;
+  }
+  SSL_BRIDGE_X448_CALLBACK expected = nullptr;
+  // Allow repeated registration of the same process-lifetime provider, but
+  // never let another thread swap its implementation during a handshake.
+  return g_bridge_x448_callback.compare_exchange_strong(
+             expected, callback, std::memory_order_acq_rel,
+             std::memory_order_acquire) || expected == callback;
+}
