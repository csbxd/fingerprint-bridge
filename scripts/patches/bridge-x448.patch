+// RFC 7748/RFC 8446 X448 uses exactly 56-byte inputs and outputs. The
+// callback uses the pinned constant-time provider; BoringSSL owns fresh
+// entropy, private-key lifetime, TLS transcript and key-schedule processing.
+class X448KeyShare : public SSLKeyShare {
+ public:
+  ~X448KeyShare() override {
+    OPENSSL_cleanse(private_key_, sizeof(private_key_));
+  }
+
+  uint16_t GroupID() const override { return SSL_GROUP_X448; }
+
+  bool Generate(CBB *out) override {
+    auto callback = g_bridge_x448_callback.load(std::memory_order_acquire);
+    static const uint8_t kBasePoint[56] = {5};
+    uint8_t public_key[56];
+    if (callback == nullptr ||
+        !RAND_bytes(private_key_, sizeof(private_key_)) ||
+        !callback(public_key, private_key_, kBasePoint)) {
+      OPENSSL_cleanse(private_key_, sizeof(private_key_));
+      has_private_key_ = false;
+      OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+      return false;
+    }
+    has_private_key_ = true;
+    return CBB_add_bytes(out, public_key, sizeof(public_key));
+  }
+
+  bool Encap(CBB *out, Array<uint8_t> *out_secret, uint8_t *out_alert,
+             Span<const uint8_t> peer_key) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    return Generate(out) && Decap(out_secret, out_alert, peer_key);
+  }
+
+  bool Decap(Array<uint8_t> *out_secret, uint8_t *out_alert,
+             Span<const uint8_t> peer_key) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    auto callback = g_bridge_x448_callback.load(std::memory_order_acquire);
+    if (!has_private_key_ || callback == nullptr) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+      return false;
+    }
+    Array<uint8_t> secret;
+    if (!secret.InitForOverwrite(56)) {
+      return false;
+    }
+    static const uint8_t kZero[56] = {};
+    if (peer_key.size() != 56 ||
+        !callback(secret.data(), private_key_, peer_key.data()) ||
+        CRYPTO_memcmp(secret.data(), kZero, sizeof(kZero)) == 0) {
+      OPENSSL_cleanse(secret.data(), secret.size());
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+    *out_secret = std::move(secret);
+    return true;
+  }
+
+  bool SerializePrivateKey(CBB *out) override {
+    return has_private_key_ &&
+           CBB_add_bytes(out, private_key_, sizeof(private_key_));
+  }
+
+  bool DeserializePrivateKey(CBS *in) override {
+    if (CBS_len(in) != sizeof(private_key_) ||
+        !CBS_copy_bytes(in, private_key_, sizeof(private_key_))) {
+      return false;
+    }
+    has_private_key_ = true;
+    return true;
+  }
+
+ private:
+  uint8_t private_key_[56] = {};
+  bool has_private_key_ = false;
+};
