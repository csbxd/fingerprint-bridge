 extern const EVP_PKEY_ASN1_METHOD dsa_asn1_meth;
 
+struct DSA_PKEY_CTX {
+  const EVP_MD *md;
+};
+
+static int pkey_dsa_init(EVP_PKEY_CTX *ctx) {
+  ctx->data = OPENSSL_zalloc(sizeof(DSA_PKEY_CTX));
+  return ctx->data != nullptr;
+}
+
+static int pkey_dsa_copy(EVP_PKEY_CTX *dst, EVP_PKEY_CTX *src) {
+  if (!pkey_dsa_init(dst)) {
+    return 0;
+  }
+  *reinterpret_cast<DSA_PKEY_CTX *>(dst->data) =
+      *reinterpret_cast<const DSA_PKEY_CTX *>(src->data);
+  return 1;
+}
+
+static void pkey_dsa_cleanup(EVP_PKEY_CTX *ctx) {
+  OPENSSL_free(ctx->data);
+  ctx->data = nullptr;
+}
+
+static int pkey_dsa_sign(EVP_PKEY_CTX *ctx, uint8_t *sig, size_t *siglen,
+                         const uint8_t *digest, size_t digest_len) {
+  const DSA *dsa = reinterpret_cast<const DSA *>(ctx->pkey->pkey);
+  if (sig == nullptr) {
+    *siglen = DSA_size(dsa);
+    return 1;
+  }
+  if (*siglen < static_cast<size_t>(DSA_size(dsa))) {
+    OPENSSL_PUT_ERROR(EVP, EVP_R_BUFFER_TOO_SMALL);
+    return 0;
+  }
+  unsigned signature_len;
+  if (!DSA_sign(0, digest, digest_len, sig, &signature_len, dsa)) {
+    return 0;
+  }
+  *siglen = signature_len;
+  return 1;
+}
+
+static int pkey_dsa_verify(EVP_PKEY_CTX *ctx, const uint8_t *sig,
+                           size_t sig_len, const uint8_t *digest,
+                           size_t digest_len) {
+  const DSA *dsa = reinterpret_cast<const DSA *>(ctx->pkey->pkey);
+  int valid;
+  return DSA_check_signature(&valid, digest, digest_len, sig, sig_len, dsa) && valid;
+}
+
+static int pkey_dsa_ctrl(EVP_PKEY_CTX *ctx, int type, int, void *value) {
+  auto *dctx = reinterpret_cast<DSA_PKEY_CTX *>(ctx->data);
+  switch (type) {
+    case EVP_PKEY_CTRL_MD: {
+      const EVP_MD *md = reinterpret_cast<const EVP_MD *>(value);
+      const int nid = EVP_MD_type(md);
+      if (nid != NID_sha1 && nid != NID_sha224 && nid != NID_sha256 &&
+          nid != NID_sha384 && nid != NID_sha512) {
+        OPENSSL_PUT_ERROR(EVP, EVP_R_INVALID_DIGEST_TYPE);
+        return 0;
+      }
+      dctx->md = md;
+      return 1;
+    }
+    case EVP_PKEY_CTRL_GET_MD:
+      *reinterpret_cast<const EVP_MD **>(value) = dctx->md;
+      return 1;
+    default:
+      OPENSSL_PUT_ERROR(EVP, EVP_R_COMMAND_NOT_SUPPORTED);
+      return 0;
+  }
+}
+
+static const EVP_PKEY_CTX_METHOD dsa_pkey_meth = {
+    EVP_PKEY_DSA,
+    pkey_dsa_init,
+    pkey_dsa_copy,
+    pkey_dsa_cleanup,
+    nullptr /* keygen */,
+    pkey_dsa_sign,
+    nullptr /* sign_message */,
+    pkey_dsa_verify,
+    nullptr /* verify_message */,
+    nullptr /* verify_recover */,
+    nullptr /* encrypt */,
+    nullptr /* decrypt */,
+    nullptr /* derive */,
+    nullptr /* paramgen */,
+    pkey_dsa_ctrl,
+};
