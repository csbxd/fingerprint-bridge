@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+# RFC 5639 sections 3.4, 3.6 and 3.7: fixed Brainpool r1 parameters.
+# Generates only representation constants for existing EC_GFp_mont_method;
+# it does not implement curve arithmetic or accept untrusted custom parameters.
+from pathlib import Path
+
+PARAMETERS = {256: {'p': 'a9fb57dba1eea9bc3e660a909d838d726e3bf623d52620282013481d1f6e5377',
+       'a': '7d5a0975fc2c3057eef67530417affe7fb8055c126dc5c6ce94a4b44f330b5d9',
+       'b': '26dc5c6ce94a4b44f330b5d9bbd77cbf958416295cf7e1ce6bccdc18ff8c07b6',
+       'gx': '8bd2aeb9cb7e57cb2c4b482ffc81b7afb9de27e1e3bd23c23a4453bd9ace3262',
+       'gy': '547ef835c3dac4fd97f8461a14611dc9c27745132ded8e545c1d54c72f046997',
+       'n': 'a9fb57dba1eea9bc3e660a909d838d718c397aa3b561a6f7901e0e82974856a7'},
+ 384: {'p': '8cb91e82a3386d280f5d6f7e50e641df152f7109ed5456b412b1da197fb71123acd3a729901d1a71874700133107ec53',
+       'a': '7bc382c63d8c150c3c72080ace05afa0c2bea28e4fb22787139165efba91f90f8aa5814a503ad4eb04a8c7dd22ce2826',
+       'b': '4a8c7dd22ce28268b39b55416f0447c2fb77de107dcd2a62e880ea53eeb62d57cb4390295dbc9943ab78696fa504c11',
+       'gx': '1d1c64f068cf45ffa2a63a81b7c13f6b8847a3e77ef14fe3db7fcafe0cbd10e8e826e03436d646aaef87b2e247d4af1e',
+       'gy': '8abe1d7520f9c2a45cb1eb8e95cfd55262b70b29feec5864e19c054ff99129280e4646217791811142820341263c5315',
+       'n': '8cb91e82a3386d280f5d6f7e50e641df152f7109ed5456b31f166e6cac0425a7cf3ab6af6b7fc3103b883202e9046565'},
+ 512: {'p': 'aadd9db8dbe9c48b3fd4e6ae33c9fc07cb308db3b3c9d20ed6639cca703308717d4d9b009bc66842aecda12ae6a380e62881ff2f2d82c68528aa6056583a48f3',
+       'a': '7830a3318b603b89e2327145ac234cc594cbdd8d3df91610a83441caea9863bc2ded5d5aa8253aa10a2ef1c98b9ac8b57f1117a72bf2c7b9e7c1ac4d77fc94ca',
+       'b': '3df91610a83441caea9863bc2ded5d5aa8253aa10a2ef1c98b9ac8b57f1117a72bf2c7b9e7c1ac4d77fc94cadc083e67984050b75ebae5dd2809bd638016f723',
+       'gx': '81aee4bdd82ed9645a21322e9c4c6a9385ed9f70b5d916c1b43b62eef4d0098eff3b1f78e2d0d48d50d1687b93b97d5f7c6d5047406a5e688b352209bcb9f822',
+       'gy': '7dde385d566332ecc0eabfa9cf7822fdf209f70024a57b1aa000c55b881f8111b2dcde494a5f485e5bca4bd88a2763aed1ca2b2fa8f0540678cd1e0f3ad80892',
+       'n': 'aadd9db8dbe9c48b3fd4e6ae33c9fc07cb308db3b3c9d20ed6639cca70330870553e5c414ca92619418661197fac10471db1d381085ddaddb58796829ca90069'}}
+
+
+def generate():
+    lines = ["// Generated by make_brainpool_tables.py; do not edit.",
+             "// Standard domain parameters: RFC 5639 sections 3.4, 3.6, 3.7.",
+             "// The arithmetic implementation remains EC_GFp_mont_method.", ""]
+    for bits, values in PARAMETERS.items():
+        p, n = int(values['p'], 16), int(values['n'], 16)
+        assert p.bit_length() == bits and n.bit_length() == bits and n < p < 2*n
+        # cofactor=1; standard base point must satisfy the standard equation.
+        a, b, gx, gy = (int(values[k], 16) for k in ('a', 'b', 'gx', 'gy'))
+        assert (gy*gy - gx*gx*gx - a*gx - b) % p == 0
+        prefix = f'kBrainpool{bits}'
+        for modulus_name, modulus in [('Field', p), ('Order', n)]:
+            n0 = -pow(modulus, -1, 1 << 64) % (1 << 64)
+            lines.append(f'static const uint64_t {prefix}{modulus_name}N0 = UINT64_C(0x{n0:016x});')
+        for wordbits in (64, 32):
+            lines.append(('#if' if wordbits == 64 else '#elif') + f' defined(OPENSSL_{wordbits}_BIT)')
+            width = (bits + wordbits - 1) // wordbits
+            r = 1 << (width * wordbits)
+            numbers = {'Field': p, 'Order': n, 'FieldR': r % p,
+                       'FieldRR': r*r % p, 'OrderRR': r*r % n,
+                       'MontA': a*r % p, 'MontB': b*r % p,
+                       'MontGX': gx*r % p, 'MontGY': gy*r % p}
+            for name, number in numbers.items():
+                words = [(number >> (i*wordbits)) & ((1 << wordbits)-1) for i in range(width)]
+                lines.append(f'static const BN_ULONG {prefix}{name}[] = {{')
+                lines += [f'    0x{word:0{wordbits//4}x},' for word in words]
+                lines.append('};')
+        lines += ['#else', '#error "unknown word length"', '#endif', '']
+    return '\n'.join(lines)
+
+
+if __name__ == '__main__':
+    Path(__file__).with_name('brainpool_curves.h').write_text(generate())
