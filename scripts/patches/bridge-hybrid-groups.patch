+             Span<const uint8_t> ciphertext) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    if (ciphertext.size() != kECBytes + kCiphertextBytes) {
+      return InvalidPeer(out_alert);
+    }
+    Array<uint8_t> ec_secret, secret;
+    if (!ec_.Decap(&ec_secret, out_alert, ciphertext.first(kECBytes)) ||
+        !secret.InitForOverwrite(ec_secret.size() + MLKEM_SHARED_SECRET_BYTES)) {
+      return false;
+    }
+    OPENSSL_memcpy(secret.data(), ec_secret.data(), ec_secret.size());
+    int ok;
+    if constexpr (kP384) {
+      ok = MLKEM1024_decap(secret.data() + ec_secret.size(),
+                           ciphertext.data() + kECBytes, kCiphertextBytes,
+                           &private_key_);
+    } else {
+      ok = MLKEM768_decap(secret.data() + ec_secret.size(),
