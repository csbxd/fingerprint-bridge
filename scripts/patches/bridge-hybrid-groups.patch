+  bool Generate(CBB *out) override {
+    uint8_t public_key[kPublicKeyBytes];
+    if constexpr (kP384) {
+      MLKEM1024_generate_key(public_key, nullptr, &private_key_);
+    } else {
+      MLKEM768_generate_key(public_key, nullptr, &private_key_);
+    }
+    return ec_.Generate(out) &&
+           CBB_add_bytes(out, public_key, sizeof(public_key));
