+  bool Encap(CBB *out_ciphertext, Array<uint8_t> *out_secret,
+             uint8_t *out_alert, Span<const uint8_t> peer_key) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    if (peer_key.size() != kECBytes + kPublicKeyBytes) {
+      return InvalidPeer(out_alert);
+    }
+    std::conditional_t<kP384, MLKEM1024_public_key, MLKEM768_public_key> pub;
+    CBS encoded;
+    CBS_init(&encoded, peer_key.data() + kECBytes, kPublicKeyBytes);
+    bool valid;
+    if constexpr (kP384) {
+      valid = MLKEM1024_parse_public_key(&pub, &encoded);
+    } else {
+      valid = MLKEM768_parse_public_key(&pub, &encoded);
+    }
+    if (!valid || CBS_len(&encoded) != 0) {
+      return InvalidPeer(out_alert);
+    }
+    Array<uint8_t> ec_secret, secret;
+    if (!ec_.Encap(out_ciphertext, &ec_secret, out_alert,
+                   peer_key.first(kECBytes)) ||
+        !secret.InitForOverwrite(ec_secret.size() + MLKEM_SHARED_SECRET_BYTES)) {
+      return false;
+    }
+    OPENSSL_memcpy(secret.data(), ec_secret.data(), ec_secret.size());
+    uint8_t ciphertext[kCiphertextBytes];
+    if constexpr (kP384) {
+      MLKEM1024_encap(ciphertext, secret.data() + ec_secret.size(), &pub);
+    } else {
+      MLKEM768_encap(ciphertext, secret.data() + ec_secret.size(), &pub);
+    }
