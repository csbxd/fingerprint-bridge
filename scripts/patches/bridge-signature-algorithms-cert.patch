+// Certificate Signature Algorithms.
+//
+// RFC 8446 section 4.2.3 permits this list to differ from
+// signature_algorithms. It constrains certificate-chain signatures rather than
+// CertificateVerify, so it must be emitted as a distinct extension.
+static bool ext_sigalgs_cert_add_clienthello(const SSL_HANDSHAKE *hs, CBB *out,
+                                             CBB *out_compressible,
+                                             ssl_client_hello_type_t type) {
+  if (hs->max_version < TLS1_2_VERSION ||
+      hs->config->cert_verify_sigalgs.empty()) {
+    return true;
+  }
+  // In PAKE mode, certificate signatures are not used.
+  if (hs->pake_prover != nullptr) {
+    return true;
+  }
+
+  CBB contents, sigalgs_cbb;
+  if (!CBB_add_u16(out_compressible,
+                   TLSEXT_TYPE_signature_algorithms_cert) ||
+      !CBB_add_u16_length_prefixed(out_compressible, &contents) ||
+      !CBB_add_u16_length_prefixed(&contents, &sigalgs_cbb)) {
+    return false;
+  }
+  for (uint16_t sigalg : hs->config->cert_verify_sigalgs) {
+    if (!CBB_add_u16(&sigalgs_cbb, sigalg)) {
+      return false;
+    }
+  }
+  return CBB_flush(out_compressible);
+}
