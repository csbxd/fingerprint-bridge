+int SSL_set_bridge_cert_verify_algorithm_prefs(SSL *ssl,
+                                               const uint16_t *prefs,
+                                               size_t num_prefs) {
+  if (!ssl->config) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+
+  return set_sigalg_prefs(&ssl->config->cert_verify_sigalgs,
+                          Span(prefs, num_prefs));
+}
