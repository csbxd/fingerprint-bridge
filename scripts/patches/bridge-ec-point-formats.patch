+int SSL_set_bridge_ec_point_formats(SSL *ssl, const uint8_t *formats,
+                                    size_t count) {
+  if (ssl->config == nullptr || ssl->s3->initial_handshake_complete ||
+      SSL_is_dtls(ssl) || formats == nullptr || count == 0 || count > 2) {
+    return 0;
+  }
+  bool seen_uncompressed = false;
+  bool seen_compressed_prime = false;
+  for (size_t i = 0; i < count; i++) {
+    if (formats[i] == TLSEXT_ECPOINTFORMAT_uncompressed) {
+      if (seen_uncompressed) {
+        return 0;
+      }
+      seen_uncompressed = true;
+    } else if (formats[i] ==
+               TLSEXT_ECPOINTFORMAT_ansiX962_compressed_prime) {
+      if (seen_compressed_prime) {
+        return 0;
+      }
+      seen_compressed_prime = true;
+    } else {
+      return 0;
+    }
+  }
+  return seen_uncompressed &&
+         ssl->config->bridge_ec_point_formats.CopyFrom(Span(formats, count));
+}
