+// EVP_pkey_ed448 implements verification-only Ed448 public keys (RFC 8032),
+// encoded as in RFC 8410. Signing and private key import are not supported.
+// Verification fails closed until the application installs a real provider.
+OPENSSL_EXPORT const EVP_PKEY_ALG *EVP_pkey_ed448(void);
+
+// The provider verifies PureEd448 with an empty context, using a 57-byte public
+// key and 114-byte signature. Return exactly one on success, zero otherwise.
+// The provider must validate the encoded key and signature, and remain alive
+// for the process lifetime. Null message is permitted only for an empty message.
+typedef int (*EVP_BRIDGE_ED448_VERIFY_CALLBACK)(
+    const uint8_t public_key[57], const uint8_t *message, size_t message_len,
+    const uint8_t signature[114]);
+// Installation is atomic and cannot replace or remove an installed provider.
+OPENSSL_EXPORT int EVP_set_bridge_ed448_verify_callback(
+    EVP_BRIDGE_ED448_VERIFY_CALLBACK callback);
+OPENSSL_EXPORT int EVP_bridge_ed448_verify_available(void);
