+
+namespace {
+
+// This bridge only needs peer signature verification. Keeping the public-key
+// method here reuses the EVP/SPKI/X.509 validation path without implementing or
+// claiming Ed448 private-key operations.
+struct ED448_PUBLIC_KEY {
+  uint8_t key[57];
+};
+
+std::atomic<EVP_BRIDGE_ED448_VERIFY_CALLBACK> bridge_ed448_verify{nullptr};
+extern const EVP_PKEY_ASN1_METHOD ed448_asn1_meth;
+
+static void ed448_free(EVP_PKEY *pkey) {
+  OPENSSL_free(pkey->pkey);
+  pkey->pkey = nullptr;
+}
+
+static int ed448_set_pub_raw(EVP_PKEY *pkey, const uint8_t *in, size_t len) {
+  if (len != 57 || in == nullptr) {
+    OPENSSL_PUT_ERROR(EVP, EVP_R_DECODE_ERROR);
+    return 0;
+  }
+  ED448_PUBLIC_KEY *key = reinterpret_cast<ED448_PUBLIC_KEY *>(
+      OPENSSL_malloc(sizeof(ED448_PUBLIC_KEY)));
+  if (key == nullptr) {
+    return 0;
+  }
+  OPENSSL_memcpy(key->key, in, 57);
+  evp_pkey_set0(pkey, &ed448_asn1_meth, key);
+  return 1;
+}
+
+static int ed448_get_pub_raw(const EVP_PKEY *pkey, uint8_t *out,
+                             size_t *out_len) {
+  if (out == nullptr) {
+    *out_len = 57;
+    return 1;
+  }
+  if (*out_len < 57) {
+    OPENSSL_PUT_ERROR(EVP, EVP_R_BUFFER_TOO_SMALL);
+    return 0;
+  }
+  const auto *key = reinterpret_cast<const ED448_PUBLIC_KEY *>(pkey->pkey);
+  OPENSSL_memcpy(out, key->key, 57);
+  *out_len = 57;
+  return 1;
+}
+
+static evp_decode_result_t ed448_pub_decode(const EVP_PKEY_ALG *alg,
+                                           EVP_PKEY *out, CBS *params,
+                                           CBS *key) {
+  // RFC 8410, section 3: parameters MUST be absent, including ASN.1 NULL.
+  if (CBS_len(params) != 0) {
+    OPENSSL_PUT_ERROR(EVP, EVP_R_DECODE_ERROR);
+    return evp_decode_error;
+  }
+  return ed448_set_pub_raw(out, CBS_data(key), CBS_len(key))
+             ? evp_decode_ok
+             : evp_decode_error;
+}
+
+static int ed448_pub_encode(CBB *out, const EVP_PKEY *pkey) {
+  const auto *key = reinterpret_cast<const ED448_PUBLIC_KEY *>(pkey->pkey);
+  CBB spki, algorithm, key_bitstring;
+  if (!CBB_add_asn1(out, &spki, CBS_ASN1_SEQUENCE) ||
+      !CBB_add_asn1(&spki, &algorithm, CBS_ASN1_SEQUENCE) ||
+      !CBB_add_asn1_element(&algorithm, CBS_ASN1_OBJECT, ed448_asn1_meth.oid,
+                            ed448_asn1_meth.oid_len) ||
+      !CBB_add_asn1(&spki, &key_bitstring, CBS_ASN1_BITSTRING) ||
+      !CBB_add_u8(&key_bitstring, 0) ||
+      !CBB_add_bytes(&key_bitstring, key->key, 57) || !CBB_flush(out)) {
+    OPENSSL_PUT_ERROR(EVP, EVP_R_ENCODE_ERROR);
+    return 0;
+  }
+  return 1;
+}
+
+static int ed448_pub_cmp(const EVP_PKEY *a, const EVP_PKEY *b) {
+  const auto *a_key = reinterpret_cast<const ED448_PUBLIC_KEY *>(a->pkey);
+  const auto *b_key = reinterpret_cast<const ED448_PUBLIC_KEY *>(b->pkey);
+  return OPENSSL_memcmp(a_key->key, b_key->key, 57) == 0;
+}
+
+static int ed448_size(const EVP_PKEY *pkey) { return 114; }
+// EVP_PKEY_bits reports the bit length of the EC group order (RFC 8032, 5.2).
+static int ed448_bits(const EVP_PKEY *pkey) { return 446; }
+static int pkey_ed448_copy(EVP_PKEY_CTX *dst, EVP_PKEY_CTX *src) { return 1; }
+
+static int pkey_ed448_verify_message(EVP_PKEY_CTX *ctx, const uint8_t *sig,
+                                     size_t siglen, const uint8_t *tbs,
+                                     size_t tbslen) {
+  auto callback = bridge_ed448_verify.load(std::memory_order_acquire);
+  if (callback == nullptr) {
+    OPENSSL_PUT_ERROR(EVP, EVP_R_UNSUPPORTED_ALGORITHM);
+    return 0;
+  }
+  const auto *key =
+      reinterpret_cast<const ED448_PUBLIC_KEY *>(ctx->pkey->pkey);
+  if (siglen != 114 || sig == nullptr ||
+      callback(key->key, tbs, tbslen, sig) != 1) {
+    OPENSSL_PUT_ERROR(EVP, EVP_R_INVALID_SIGNATURE);
+    return 0;
+  }
+  return 1;
+}
+
+const EVP_PKEY_CTX_METHOD ed448_pkey_meth = {
+    /*pkey_id=*/EVP_PKEY_ED448,
+    /*init=*/nullptr,
+    /*copy=*/pkey_ed448_copy,
+    /*cleanup=*/nullptr,
+    /*keygen=*/nullptr,
+    /*sign=*/nullptr,
+    /*sign_message=*/nullptr,
+    /*verify=*/nullptr,
+    /*verify_message=*/pkey_ed448_verify_message,
+    /*verify_recover=*/nullptr,
+    /*encrypt=*/nullptr,
+    /*decrypt=*/nullptr,
+    /*derive=*/nullptr,
+    /*paramgen=*/nullptr,
+    /*ctrl=*/nullptr,
+};
+
+const EVP_PKEY_ASN1_METHOD ed448_asn1_meth = {
+    EVP_PKEY_ED448,
+    {0x2b, 0x65, 0x71},
+    3,
+    &ed448_pkey_meth,
+    ed448_pub_decode,
+    ed448_pub_encode,
+    ed448_pub_cmp,
+    /*priv_decode=*/nullptr,
+    /*priv_encode=*/nullptr,
+    /*set_priv_raw=*/nullptr,
+    /*set_priv_seed=*/nullptr,
+    ed448_set_pub_raw,
+    /*get_priv_raw=*/nullptr,
+    /*get_priv_seed=*/nullptr,
+    ed448_get_pub_raw,
+    /*set1_tls_encodedpoint=*/nullptr,
+    /*get1_tls_encodedpoint=*/nullptr,
+    /*pkey_opaque=*/nullptr,
+    ed448_size,
+    ed448_bits,
+    /*param_missing=*/nullptr,
+    /*param_copy=*/nullptr,
+    /*param_cmp=*/nullptr,
+    ed448_free,
+};
+
+}  // namespace
+
+const EVP_PKEY_ALG *EVP_pkey_ed448(void) {
+  static const EVP_PKEY_ALG kAlg = {&ed448_asn1_meth};
+  return &kAlg;
+}
+
+int EVP_set_bridge_ed448_verify_callback(
+    EVP_BRIDGE_ED448_VERIFY_CALLBACK callback) {
+  if (callback == nullptr) {
+    return 0;
+  }
+  EVP_BRIDGE_ED448_VERIFY_CALLBACK expected = nullptr;
+  return bridge_ed448_verify.compare_exchange_strong(
+             expected, callback, std::memory_order_acq_rel,
+             std::memory_order_acquire) || expected == callback;
+}
+
+int EVP_bridge_ed448_verify_available(void) {
+  return bridge_ed448_verify.load(std::memory_order_acquire) != nullptr;
+}
