+static UniquePtr<DH> FFDHEParameters(uint16_t group_id) {
+  const char *prime = nullptr;
+  switch (group_id) {
+    case SSL_GROUP_FFDHE2048: prime = kFFDHE2048Prime; break;
+    case SSL_GROUP_FFDHE3072: prime = kFFDHE3072Prime; break;
+    case SSL_GROUP_FFDHE4096: prime = kFFDHE4096Prime; break;
+    case SSL_GROUP_FFDHE6144: prime = kFFDHE6144Prime; break;
+    case SSL_GROUP_FFDHE8192: prime = kFFDHE8192Prime; break;
+    default: return nullptr;
+  }
+  BIGNUM *p_raw = nullptr;
+  if (!BN_hex2bn(&p_raw, prime)) {
+    return nullptr;
+  }
+  UniquePtr<BIGNUM> p(p_raw), g(BN_new());
+  UniquePtr<DH> dh(DH_new());
+  if (!dh || !g || !BN_set_word(g.get(), 2) ||
+      !DH_set0_pqg(dh.get(), p.get(), nullptr, g.get())) {
+    return nullptr;
+  }
+  p.release();
+  g.release();
+  return dh;
+}
