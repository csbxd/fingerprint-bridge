+class FFDHEKeyShare : public SSLKeyShare {
+ public:
+  explicit FFDHEKeyShare(uint16_t group_id) : group_id_(group_id) {}
+  uint16_t GroupID() const override { return group_id_; }
+
+  bool Generate(CBB *out) override {
+    dh_ = FFDHEParameters(group_id_);
+    return dh_ && DH_generate_key(dh_.get()) &&
+           BN_bn2cbb_padded(out, DH_size(dh_.get()), DH_get0_pub_key(dh_.get()));
+  }
+
+  bool Encap(CBB *out, Array<uint8_t> *secret, uint8_t *alert,
+             Span<const uint8_t> peer) override {
+    *alert = SSL_AD_INTERNAL_ERROR;
+    return Generate(out) && Decap(secret, alert, peer);
+  }
+
+  bool Decap(Array<uint8_t> *out_secret, uint8_t *out_alert,
+             Span<const uint8_t> peer) override {
+    *out_alert = SSL_AD_INTERNAL_ERROR;
+    if (!dh_) {
+      return false;
+    }
+    if (peer.size() != static_cast<size_t>(DH_size(dh_.get()))) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_DH_P_LENGTH);
+      return false;
+    }
+    UniquePtr<BIGNUM> y(BN_bin2bn(peer.data(), peer.size(), nullptr));
+    int flags = 0;
+    if (!y || !DH_check_pub_key(dh_.get(), y.get(), &flags)) {
+      return false;
+    }
+    // RFC 7919: 1 < Y < p-1. Check before performing private exponentiation.
+    if (flags != 0) {
+      *out_alert = SSL_AD_ILLEGAL_PARAMETER;
+      OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+      return false;
+    }
+    Array<uint8_t> secret;
+    if (!secret.InitForOverwrite(DH_size(dh_.get())) ||
+        DH_compute_key_padded(secret.data(), y.get(), dh_.get()) !=
+            static_cast<int>(secret.size())) {
+      return false;
+    }
+    // TLS 1.3 keeps leading zero bytes in the fixed-width shared secret.
+    *out_secret = std::move(secret);
+    return true;
+  }
+
+ private:
+  const uint16_t group_id_;
+  UniquePtr<DH> dh_;
+};
 
